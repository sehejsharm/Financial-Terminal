# ─── Copy to .env on the VM, then fill in. .env is gitignored — NEVER commit it. ───
#   cp .env.example .env && nano .env

# Public HTTPS domain: a free DuckDNS subdomain pointed at this VM's public IP.
# Create one at https://www.duckdns.org (sign in with GitHub/Google — no card).
DOMAIN=motherboard-sehej.duckdns.org

# ─── Backend auth ───
MOTHERBOARD_ADMIN_USER=Sehej
MOTHERBOARD_ADMIN_PASSWORD=use-a-long-random-password
# Persistent JWT signing secret. Generate one with:  openssl rand -hex 32
BACKEND_JWT_SECRET=

# Comma-separated allowed origins — your Vercel frontend URL(s).
BACKEND_CORS_ORIGINS=https://financial-terminal-peach.vercel.app

# ─── Passkeys (fingerprint / Face ID sign-in) ───
# A passkey is cryptographically bound to ONE domain. Leave these blank and the
# relying-party id is derived from the first BACKEND_CORS_ORIGINS host, which is
# correct for a single-domain deployment.
#
# MOVING TO A CUSTOM DOMAIN INVALIDATES EVERY EXISTING PASSKEY — browsers will
# simply stop offering them. That is survivable only because passwords still
# work: affected users sign in with their password and enrol again. Set this to
# the registrable domain (example.com, not app.example.com) if subdomains might
# ever serve the app; widening it later invalidates credentials, narrowing does
# not.
# WEBAUTHN_RP_ID=motherboard.example
# WEBAUTHN_RP_NAME=Motherboard Terminal
# Exact origins allowed to run a ceremony. Defaults to BACKEND_CORS_ORIGINS.
# WEBAUTHN_ORIGINS=https://motherboard.example

# ─── Data providers ───
# Groq (AI bull/bear + deep analysis) — free at https://console.groq.com
GROQ_API_KEY=
# FRED (macro indicators / yield curve) — free at https://fredaccount.stlouisfed.org
FRED_API_KEY=
# Twelve Data (quotes/stats fallback) — free at https://twelvedata.com
TWELVE_DATA_API_KEY=
# Financial Modeling Prep (US financial statements) — free at https://financialmodelingprep.com
FMP_API_KEY=

# ─── Alert delivery (all optional; alerts stay in-app without them) ───
# NOTE: everything in this section can ALSO be configured from the web UI
# (Alerts → Admin: delivery setup, master admin only) — no env editing or
# restart needed. Env values take priority when both are set.
# Email: any SMTP relay works (Gmail: smtp.gmail.com:587 + an App Password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=
# Browser push: generate a key pair once with
#   npx web-push generate-vapid-keys
# then paste both keys here and restart. Each browser opts in from the
# Alerts page ("Enable push on this device").
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUB=mailto:you@example.com
# Telegram "text message" alerts (free): create a bot with @BotFather
# (/newbot) and paste its token. Users link their own chat from the
# Alerts page ("Link my Telegram").
TELEGRAM_BOT_TOKEN=

# ── sessions, cookies, proxy ──────────────────────────────────────────────
# Reverse-proxy hops in front of the app. The compose file sets this to 1 for
# the backend service, where Caddy is guaranteed; it is here only for a
# deployment that differs. 0 means "ignore X-Forwarded-For", which is the
# fail-safe. Get it wrong and the rate limiter charges every request on the
# internet to one bucket. See backend/ratelimit.client_ip.
#TRUSTED_PROXY_HOPS=1

# Access-token lifetime in minutes. Default 15. The long-lived half of the
# session is the refresh token in backend/sessions.py, which IS revocable —
# widening this widens the window in which a revoked session still works.
#BACKEND_JWT_TTL_MIN=15

# ── environment ───────────────────────────────────────────────────────────
# Set to "production" to turn configuration that is merely convenient in
# development into a hard failure at startup.
#
# READ THIS BEFORE SETTING IT: with MOTHERBOARD_ENV=production the app REFUSES
# TO BOOT unless WEBAUTHN_RP_ID is also set explicitly. That is deliberate —
# the RP ID is baked into every enrolled passkey, so deriving it from the CORS
# list means reordering that list silently invalidates every passkey — but it
# does mean these two go in together or not at all.
#MOTHERBOARD_ENV=production
#WEBAUTHN_RP_ID=sehejmotherboard.duckdns.org

# Serve /docs, /redoc and /openapi.json. Off by default: in production they
# publish the full route inventory and the admin surface to anyone.
#EXPOSE_API_DOCS=1

# ── transactional email (invites, password resets) ────────────────────────
# resend | smtp | console. Default console, which logs the message including
# the link and sends nothing — that is what makes the invite and reset flow
# testable locally without spending anything or mailing a real person.
#
# A deploy left on `console` will create accounts whose owners never receive
# an invite, and the admin screen reports the send failure, so this is worth
# setting before inviting anyone.
#MAIL_PROVIDER=resend
#RESEND_API_KEY=re_...
# Must be on a domain verified in Resend, or every send is rejected.
#MAIL_FROM=Motherboard <noreply@your-verified-domain.com>

# Where the set-password page lives — the FRONT END's origin, not the API's.
# This is what invite and reset links point at, so if it is wrong the emails
# go out with links to nowhere.
#APP_BASE_URL=https://financial-terminal-peach.vercel.app

# ── market data planes ────────────────────────────────────────────────────
# Which licensed real-time feed adapter to use. Unset (the default) means
# there is no licensed feed: every tier is served public data (NSE, Twelve
# Data, yfinance) and labelled as such. No adapter ships yet — see
# docs/DATA-PLANE.md for what writing one involves.
#
# An unknown value here does NOT stop the app: it logs an error and falls back
# to public data for everyone, so paid accounts would show "Public data"
# instead of live prices. Check /api/v1/stream/health after setting it.
#REALTIME_FEED=

# How far behind free accounts see LICENSED data. Irrelevant until a feed is
# configured, because public data is never delayed. 900s (15 min) is the
# conventional exchange figure; use whatever the signed contract says.
#DELAYED_FEED_SECONDS=900

# ── compliance ────────────────────────────────────────────────────────────
# The complaint address printed on /disclosures. MUST be set before launch:
# it defaults to a .invalid address, and a page that says an address is
# monitored while it bounces is worse than not offering one. This is a
# frontend variable, so it is set in Vercel, not here — listed for
# completeness. See docs/COMPLIANCE.md.
#NEXT_PUBLIC_GRIEVANCE_EMAIL=support@yourdomain.com
