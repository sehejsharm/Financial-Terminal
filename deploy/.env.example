# ─── Copy to .env on the VM, then fill in. .env is gitignored — NEVER commit it. ───
#   cp .env.example .env && nano .env

# Public HTTPS domain: a free DuckDNS subdomain pointed at this VM's public IP.
# Create one at https://www.duckdns.org (sign in with GitHub/Google — no card).
DOMAIN=motherboard-sehej.duckdns.org

# ─── Backend auth ───
MOTHERBOARD_ADMIN_USER=Sehej
MOTHERBOARD_ADMIN_PASSWORD=use-a-long-random-password
# Persistent JWT signing secret. Generate one with:  openssl rand -hex 32
BACKEND_JWT_SECRET=

# Comma-separated allowed origins — your Vercel frontend URL(s).
BACKEND_CORS_ORIGINS=https://financial-terminal-peach.vercel.app

# ─── Passkeys (fingerprint / Face ID sign-in) ───
# A passkey is cryptographically bound to ONE domain. Leave these blank and the
# relying-party id is derived from the first BACKEND_CORS_ORIGINS host, which is
# correct for a single-domain deployment.
#
# MOVING TO A CUSTOM DOMAIN INVALIDATES EVERY EXISTING PASSKEY — browsers will
# simply stop offering them. That is survivable only because passwords still
# work: affected users sign in with their password and enrol again. Set this to
# the registrable domain (example.com, not app.example.com) if subdomains might
# ever serve the app; widening it later invalidates credentials, narrowing does
# not.
# WEBAUTHN_RP_ID=motherboard.example
# WEBAUTHN_RP_NAME=Motherboard Terminal
# Exact origins allowed to run a ceremony. Defaults to BACKEND_CORS_ORIGINS.
# WEBAUTHN_ORIGINS=https://motherboard.example

# ─── Data providers ───
# Groq (AI bull/bear + deep analysis) — free at https://console.groq.com
GROQ_API_KEY=
# FRED (macro indicators / yield curve) — free at https://fredaccount.stlouisfed.org
FRED_API_KEY=
# Twelve Data (quotes/stats fallback) — free at https://twelvedata.com
TWELVE_DATA_API_KEY=
# Financial Modeling Prep (US financial statements) — free at https://financialmodelingprep.com
FMP_API_KEY=

# ─── Alert delivery (all optional; alerts stay in-app without them) ───
# NOTE: everything in this section can ALSO be configured from the web UI
# (Alerts → Admin: delivery setup, master admin only) — no env editing or
# restart needed. Env values take priority when both are set.
# Email: any SMTP relay works (Gmail: smtp.gmail.com:587 + an App Password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=
# Browser push: generate a key pair once with
#   npx web-push generate-vapid-keys
# then paste both keys here and restart. Each browser opts in from the
# Alerts page ("Enable push on this device").
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUB=mailto:you@example.com
# Telegram "text message" alerts (free): create a bot with @BotFather
# (/newbot) and paste its token. Users link their own chat from the
# Alerts page ("Link my Telegram").
TELEGRAM_BOT_TOKEN=
