# Copy this file to .env and fill in your own keys.
# The .env file is gitignored and will never be committed.

# ── AI provider (pick at least one) ──────────────────────────────────────────
# Groq  — RECOMMENDED: completely free, 14 400 req/day, no card needed
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Google Gemini — fallback if no Groq key is set (free tier, lower quota)
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Financial Modeling Prep (for financial statements) - free tier ~250/day
# yfinance statements are IP-blocked on cloud; FMP free covers US statements.
# Get one at https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# FRED API key (for macro indicators) - free
# Get one at https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Optional: override the seeded Master Admin login (first run only)
# MOTHERBOARD_ADMIN_USER=Sehej
# MOTHERBOARD_ADMIN_PASSWORD=change-me

# ─── Passkeys (fingerprint / Face ID sign-in) ───
# A passkey is cryptographically bound to ONE domain. Leave these blank and the
# relying-party id is derived from the first BACKEND_CORS_ORIGINS host, which is
# correct for a single-domain deployment.
#
# MOVING TO A CUSTOM DOMAIN INVALIDATES EVERY EXISTING PASSKEY — browsers will
# simply stop offering them. That is survivable only because passwords still
# work: affected users sign in with their password and enrol again. Set this to
# the registrable domain (example.com, not app.example.com) if subdomains might
# ever serve the app; widening it later invalidates credentials, narrowing does
# not.
# WEBAUTHN_RP_ID=motherboard.example
# WEBAUTHN_RP_NAME=Motherboard Terminal
# Exact origins allowed to run a ceremony. Defaults to BACKEND_CORS_ORIGINS.
# WEBAUTHN_ORIGINS=https://motherboard.example
