# Secrets
.env
.streamlit/secrets.toml

# User data (holdings, accounts/credentials, sessions) — the whole directory.
#
# This was a per-file list, which is the wrong shape for a rule whose failure
# mode is committing credentials: every new store needs a new line, and the
# atomic writer's .bak siblings were never covered, so data/notes.json was
# ignored while data/notes.json.bak was not. Nothing in here is tracked or
# should be — it is all runtime state on a mounted volume — so ignore the
# directory and stop maintaining a list that only fails in one direction.
data/

# Deploy-time secrets + runtime data (Oracle/Docker VM)
deploy/.env
deploy/data/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/

# OS
.DS_Store

# E2E test artifacts
e2e-data/
frontend/playwright-report/
frontend/test-results/

# Playwright run artifacts
test-results/
frontend/test-results/
frontend/playwright-report/

# Node (the root has no package.json, but a tool run from here creates these)
node_modules/
